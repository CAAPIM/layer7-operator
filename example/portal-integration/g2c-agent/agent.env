PORTAL_CONFIG_SECRET=portal-config-secret
PKI_SECRET=g2c-agent-tls
MANAGE_APPLICATIONS=true
REDIS_CONFIG_SECRET=redis-config-secret
REDIS_
ENROLMENT_ENDPOINT=
# GATEWAY_VERSION is the gateway version the agent reports to the Portal when it enrols, in
# major.minor.patch form (for example 11.2.2). It must fall in the version range chosen for the
# gateway in the Portal UI. Leave empty to report 11.1.0 (select "11.1.4 or older" in the UI).
GATEWAY_VERSION=
# Set BROKER_TYPE=kafka to switch from RabbitMQ/MQTT to Kafka.
# Leave empty or set to "mqtt" to keep the default RabbitMQ/MQTT transport.
BROKER_TYPE=
# KAFKA_BOOTSTRAP_SERVERS overrides the bootstrap address derived from the
# enrollment bundle (portal.config.broker.kafka.host + portal.config.broker.kafka.port).
# Set this only when BROKER_TYPE=kafka and you need to override the enrollment bundle
# value without re-enrolling the gateway, e.g.:
#   KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_TLS_ENABLED=true enables TLS for the Kafka connection.
# The Portal Kafka CA certificate must be mounted at /tmp/agent/kafka-ca.crt.
KAFKA_TLS_ENABLED=
# KAFKA_TLS_INSECURE_SKIP_VERIFY=true skips verification of the Kafka proxy certificate
# (used only when KAFKA_TLS_ENABLED=true). TEST/DEV ONLY: the default SSG "SSL" key behind
# the Kafka TCP proxy is the self-signed CN=tssg certificate without a subjectAltName, so
# the agent cannot verify it. Leave empty (verify) for real use.
KAFKA_TLS_INSECURE_SKIP_VERIFY=
KV_STORE_BACKEND=REDIS
GEMFIRE_STORE_ID=GW_STORE_ID
GEMFIRE_LOCATOR_HOST=cluster1-locator-clusterip
GEMFIRE_LOCATOR_PORT=10334
GEMFIRE_REGION_NAME=layer7gw_keyvalue

