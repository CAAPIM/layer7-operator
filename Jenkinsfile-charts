pipeline {
  agent { label 'default' }
  options {
    timeout(time: 15, unit: 'MINUTES')
  }
  environment {
    ARTIFACTORY_CREDS = credentials("ARTIFACTORY_USERNAME_TOKEN")
  }
  stages {
    stage('Push Helm Chart') {
      steps {
        script {
          // PR branches only ever push to dev-local (usw1 Artifactory blocks
          // promoting dev-local to layer7.packages.broadcom.com, so there's
          // nothing further to do for a PR build). The default branch pushes
          // to release-local; a separate promotion job pushes from there to
          // layer7.packages.broadcom.com.
          //
          // --check-changed is a cheap `ct list-changed` short-circuit, only
          // meaningful for PR builds (comparing the PR branch against main);
          // it's meaningless when already running on main itself (main vs
          // main always reports no changes), so it's omitted there. Either
          // way, push_helm_charts.py also checks whether the chart's current
          // version already exists in the target Artifactory repo and skips
          // if so, to avoid pushing a duplicate of an already-published
          // version.
          if (env.CHANGE_ID) {
            sh 'python3 push_helm_charts.py --check-changed main'
          } else if (env.BRANCH_NAME == 'main') {
            sh 'python3 push_helm_charts.py --release'
          } else {
            echo "not a PR and not main - skipping chart publish for branch ${env.BRANCH_NAME}"
          }
        }
      }
    }
  }
}
