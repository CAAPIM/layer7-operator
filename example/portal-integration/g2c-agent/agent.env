PORTAL_CONFIG_SECRET=portal-config-secret
PKI_SECRET=g2c-agent-tls
MANAGE_APPLICATIONS=true
REDIS_CONFIG_SECRET=redis-config-secret
REDIS_
ENROLMENT_ENDPOINT=
# Set BROKER_TYPE=kafka to switch from RabbitMQ/MQTT to Kafka.
# Leave empty or set to "mqtt" to keep the default RabbitMQ/MQTT transport.
BROKER_TYPE=
# KAFKA_BOOTSTRAP_SERVERS overrides the bootstrap address derived from the
# enrollment bundle (portal.config.broker.kafka.host + portal.config.broker.kafka.port).
# Set this only when BROKER_TYPE=kafka and you need to override the enrollment bundle
# value without re-enrolling the gateway, e.g.:
#   KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_TLS_ENABLED=true enables TLS for the Kafka connection.
# The Portal Kafka CA certificate must be mounted at /tmp/agent/kafka-ca.crt.
KAFKA_TLS_ENABLED=